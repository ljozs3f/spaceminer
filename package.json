{
  "name": "space-miner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.23.0"
  },
  "scripts": {
    "dev": "pnpm --filter @space-miner/client dev",
    "build": "pnpm --filter @space-miner/client build",
    "sprites": "pnpm --filter @space-miner/client sprites",
    "test": "pnpm --filter @space-miner/sim test",
    "test:watch": "pnpm --filter @space-miner/sim test:watch",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vue-eslint-parser": "10.4.2"
  }
}
