# HTTPS reverse proxy in front of the Vite dev server: https://${LOCAL_DOMAIN}
# ${LOCAL_DOMAIN} is filled in from the environment when the container starts (nginx templates).

# Docker DNS, resolved per request: the proxy keeps working when the client container is recreated
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen              443 ssl;
    http2               on;
    server_name         ${LOCAL_DOMAIN};
    ssl_certificate     /etc/nginx/ssl/fullchain.crt;
    ssl_certificate_key /etc/nginx/localdev/key.key;

    location / {
        set $client http://client:5173;
        proxy_pass         $client;
        proxy_http_version 1.1;
        # websocket for Vite hot module replacement
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }
}
