# Copy to .env to override the defaults. Every value is optional.

# Host port of the Vite dev server: http://localhost:5173
CLIENT_PORT=5173

# Local HTTPS domain, served by nginx with the *.localdev.hu certificate: https://spaceminer.localdev.hu
LOCAL_DOMAIN=spaceminer.localdev.hu
# Change it if another project already uses 443 (the URL becomes https://spaceminer.localdev.hu:<port>).
HTTPS_PORT=443

# Polling file watcher for hot reload on macOS / Windows hosts, where bind mounts may not deliver
# file change events.
VITE_USE_POLLING=false
